# API
# DATABASE_URL: para SQLite local dejar sin definir (se usa el archivo por
# defecto en <repo>/data/brugali.db). Definir sólo para PostgreSQL, por ejemplo:
# DATABASE_URL=postgresql+psycopg://brugali_app:clave@localhost:5432/brugali_costos
APP_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=alexis.carrera@brugali.com.ar
BOOTSTRAP_ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25

# Web
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Costos y precios

