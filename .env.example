# Copiar como apps/web/.env.local para desarrollo.
# En Vercel, cargar las mismas variables desde Project Settings.

# Variables públicas de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Secreto exclusivo del servidor. Nunca se expone al navegador.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

SUPABASE_IMPORTS_BUCKET=imports
