# ==========================================================
# Brugali · Costos y precios — variables de entorno
# Stack: Next.js (Vercel) + Supabase (Postgres, Auth, Storage)
# Copiar como apps/web/.env.local para desarrollo; en Vercel se
# configuran en el panel del proyecto.
# ==========================================================

# --- Supabase (público: llega al navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Supabase (secreto: SOLO backend, nunca al navegador) ---
# Clave service-role: omite RLS. Se usa en Route Handlers/Server Actions.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Bucket de Storage para las planillas importadas ---
SUPABASE_IMPORTS_BUCKET=imports
