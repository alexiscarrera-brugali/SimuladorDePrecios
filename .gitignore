# ---------------------------------------------------------------------------
# Secretos y configuración local
# Nunca versionar credenciales. Sólo .env.example es público.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.gpg
*.asc
secrets.json
credentials.json
service-account*.json
*.mmdb

# ---------------------------------------------------------------------------
# Plataformas de despliegue
# ---------------------------------------------------------------------------
.vercel/
.netlify/
.serverless/
.amplify/
.firebase/
.wrangler/

# ---------------------------------------------------------------------------
# Supabase (CLI local)
# ---------------------------------------------------------------------------
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/logs/

# ---------------------------------------------------------------------------
# Datos operativos y artefactos locales
# Contienen información comercial de Brugali: no deben salir del entorno.
# ---------------------------------------------------------------------------
/data/
/imports/
/exports/
/storage/
/tmp/
/outputs/
/work/
*.db
*.sqlite
*.sqlite3
*.dump
*.bak

# Planillas fuente (se cargan por la app, no por el repo)
*.xlsx
*.xls
*.xlsm
*.csv
!**/fixtures/**/*.csv
!**/__fixtures__/**/*.csv
!**/test/**/*.csv

# ---------------------------------------------------------------------------
